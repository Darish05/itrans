# iTantra Development API Credentials (Optional)
# If left blank, the app will use Browser Web Speech API or realistic simulated fallback.

# Google Cloud Speech-to-Text REST API Key
VITE_GOOGLE_STT_API_KEY=

# Microsoft Azure Cognitive Speech Service Credentials
VITE_MICROSOFT_TTS_API_KEY=
VITE_MICROSOFT_TTS_REGION=eastus
